# Template for .env.prod, the environment file the production stack reads.
#
# Copy to .env.prod on the droplet and fill in the real values. Never commit
# the filled-in copy. Everything not listed here keeps the default in
# app/config.py; .env.example documents the full set of knobs.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- Application ---
APP_ENV=production
LOG_LEVEL=INFO
# Origins allowed to call the API from a browser. Add the reviewer console's
# own origin, and any local dev server still pointed at this deployment.
CORS_ALLOW_ORIGINS=https://YOUR_DOMAIN

# --- Database ---
# The host is ace-db, the compose service name, not localhost: the app runs in
# its own container and localhost there is the app itself.
DATABASE_URL=postgresql+psycopg://ace:REPLACE_ME@ace-db:5432/ace
DB_TIMEZONE=Africa/Nairobi

# These three are read by compose itself to create the database, so they must
# agree with DATABASE_URL above. They are only applied the first time the
# ace_pgdata volume is created; changing them later does not change the
# existing database.
POSTGRES_USER=ace
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=ace

# --- Cytonn API ---
CY_API_BASE_URL=
CY_API_KEY=
CY_ACTIVE_CLIENTS_URL=

# --- LLM ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Secrets that sign cookies ---
# Generate each with: openssl rand -hex 32
# Leaving these at their development defaults lets anyone forge a session.
CONSOLE_SESSION_SECRET_KEY=
ADMIN_SECRET_KEY=

# --- Operational admin (/admin). Blank on either refuses every login. ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Outgoing mail ---
# A real provider, never Mailpit: that is development only. A blank SMTP_HOST
# or EMAIL_SENDER means nothing is sent and the mailer just records the intent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_SENDER=
# Where the digest email's links point.
CONSOLE_BASE_URL=https://YOUR_DOMAIN

# Refuses to generate or send for a client with no contact on file. Keep this
# on anywhere real client data lives.
REQUIRE_DELIVERABLE_CONTACT=true

# Must match Ticketing's AI_OUTREACH_JWT_SECRET exactly once Ticketing is
# calling in. Unset means every endpoint behind it refuses every request.
AI_OUTREACH_JWT_SECRET=
