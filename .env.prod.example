
APP_ENV=production
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=https://YOUR_DOMAIN


DATABASE_URL=postgresql+psycopg://ace:REPLACE_ME@ace-db:5432/ace
DB_TIMEZONE=Africa/Nairobi
POSTGRES_USER=ace
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=ace

# --- Cytonn API ---
CY_API_BASE_URL=
CY_API_KEY=
CY_ACTIVE_CLIENTS_URL=

# --- LLM ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CONSOLE_SESSION_SECRET_KEY=
ADMIN_SECRET_KEY=

ADMIN_USERNAME=
ADMIN_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_SENDER=
# Where the digest email's links point.
CONSOLE_BASE_URL=https://YOUR_DOMAIN
REQUIRE_DELIVERABLE_CONTACT=true
# Required for almost every /api/v1 route now, not just reviewer decisions --
# unset, those routes 503. Must match Ticketing's value exactly.
AI_OUTREACH_JWT_SECRET=
