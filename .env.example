# AI Client Engagement (ACE)
#
# Values marked "editable in Settings" can be changed without a redeploy from
# AI Configuration > Settings in Ticketing. A change there is stored in the
# app_setting table and wins over the value in this file, which is only the
# starting default.

# --- Application ---
APP_ENV=development              # development | staging | production
APP_NAME=AI Client Engagement
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1

# Public contact numbers the outbound scan allows in a draft, comma separated.
PUBLIC_CONTACT_NUMBERS=

# --- Database (PostgreSQL with the pgvector extension) ---
DATABASE_URL=postgresql+psycopg://**:***@localhost:5432/ace
DB_TIMEZONE=Africa/Nairobi       # time zone for database timestamps (EAT, UTC+3)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# DB_ASYNC_POOL_SIZE=10       # async pool, defaults to DB_POOL_SIZE
# DB_ASYNC_MAX_OVERFLOW=10    # async overflow, defaults to DB_MAX_OVERFLOW
WORKER_THREADS=40
SLOW_REQUEST_MS=1000
# DB_SAFE_ROLE=***   
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# TEST_DATABASE_URL=postgresql+psycopg://**:**@localhost:5432/ace_test

CY_API_BASE_URL=
CY_API_KEY=
# Full URL for the active-clients feed (Phase 2). Same API key, different path.
CY_ACTIVE_CLIENTS_URL=

# --- Retrieval grounding (editable in Settings) ---
# RAG_RETRIEVAL_K=3
# RAG_MIN_SCORE=0.1

# LLM provider
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=
# LLM_TEMPERATURE=         
# LLM_MAX_TOKENS=1024

# LLM_PROVIDER=ollama
# LLM_MODEL=phi4-mini
# OLLAMA_BASE_URL=
# OLLAMA_TIMEOUT_SECONDS=120

# LLM_PROVIDER=llamacpp
# LLM_MODEL=local-model
# LLAMACPP_BASE_URL=http://localhost:8080
# LLAMACPP_TIMEOUT_SECONDS=300

# LLM-as-judge (llmops.judge). Falls back to LLM_PROVIDER/LLM_MODEL when unset.
# JUDGE_LLM_PROVIDER=
# JUDGE_LLM_MODEL=
# JUDGE_LLM_TEMPERATURE=
# JUDGE_LLM_MAX_TOKENS=512

# AI-narrated briefing
# AI_BRIEFING_ENABLED=false
# Falls back to LLM_PROVIDER/LLM_MODEL when unset, same as JUDGE_LLM_* above.
# BRIEFING_LLM_PROVIDER=
# BRIEFING_LLM_MODEL=
# BRIEFING_LLM_TEMPERATURE=
# BRIEFING_LLM_MAX_TOKENS=1024
# BRIEFING_PREWARM_LIMIT=200


# LLM_PROVIDER/LLM_MODEL when unset.
# AGENT_LLM_PROVIDER=
# AGENT_LLM_MODEL=
# AGENT_LLM_TEMPERATURE=
# AGENT_LLM_MAX_TOKENS=2048
# AGENT_RUN_AFTER_RISK_DETECTION=false
# AGENT_RESUME_CAMPAIGNS_ENABLED=true
# AGENT_RUN_STALE_AFTER_MINUTES=120
# Who gets the run report by email when an agent run finishes, comma separated.
# Empty sends nothing.
# AGENT_REPORT_RECIPIENTS=ops@example.com,lead@example.com

# --- LLM observability / tracing (Langfuse) ---
# LANGFUSE_BASE_URL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_POSTGRES_USER=
# LANGFUSE_POSTGRES_PASSWORD=
# LANGFUSE_POSTGRES_DB=
# LANGFUSE_POSTGRES_PORT=5433
# LANGFUSE_DATABASE_URL=
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_NEXTAUTH_URL=
# LANGFUSE_REDIS_AUTH=
# LANGFUSE_MINIO_ROOT_PASSWORD=
# LANGFUSE_INIT_ORG_ID=
# LANGFUSE_INIT_ORG_NAME=
# LANGFUSE_INIT_PROJECT_ID=
# LANGFUSE_INIT_PROJECT_NAME=
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# LANGFUSE_INIT_PROJECT_SECRET_KEY=
# LANGFUSE_INIT_USER_EMAIL=
# LANGFUSE_INIT_USER_NAME=
# LANGFUSE_INIT_USER_PASSWORD=

# --- Delivery mode (editable in Settings) ---
# test sends only to the test_recipient list (manage it with scripts/test_recipients.py)
# and puts TEST_CLIENT_FIRST_NAME in place of real names. Switch to live only at go live.
# DELIVERY_MODE=test
# In live mode SMS still goes to the test_recipient list while this is true.
# Turn it off at go live so texts reach clients.
# LIVE_SMS_TO_TEST_LIST=true
# A campaign launch normally hands messages to Ticketing to queue and send.
# Turn this on if Ticketing's queue worker stops draining jobs, so ACE sends
# each message itself instead of waiting on the queue. It blocks for as long
# as the batch takes, so DISPATCH_DIRECT_SEND_MAX_BATCH caps the batch size.
# DISPATCH_DIRECT_SEND=false
# DISPATCH_DIRECT_SEND_MAX_BATCH=50
# TEST_CLIENT_FIRST_NAME=Test Client
# TEST_SUBJECT_PREFIX=[TEST]
# Test campaigns enroll at most this many clients.
# TEST_CAMPAIGN_MAX_CLIENTS=50
# Live campaigns enroll at most this many clients. 0 means no limit.
# Set a small number (5 or 10) for the first go live runs.
# LIVE_CAMPAIGN_MAX_CLIENTS=0

# --- Outgoing mail through Ticketing ---
# MAIL_TRANSPORT=ticketing sends every email through the Ticketing app's Gmail mailbox,
# signed with AI_OUTREACH_JWT_SECRET (the same secret Ticketing uses for its login tokens).
# MAIL_TRANSPORT=smtp
# TICKETING_BASE_URL=https://ticketing.cytonn.com
# TICKETING_TIMEOUT_SECONDS=30

# --- Outgoing mail (SMTP) ---
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
# SMTP_TIMEOUT_SECONDS=30
# The From address on everything the system sends. Blank means nothing sends.
# EMAIL_SENDER=
# CONSOLE_BASE_URL=http://localhost:5173

# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=
# EMAIL_WEBHOOK_SIGNING_KEY=

# --- Outgoing SMS ---
# Every SMS goes through the Ticketing app, using TICKETING_BASE_URL and
# AI_OUTREACH_JWT_SECRET. Missing either one records the SMS instead of sending it.


# AI_OUTREACH_JWT_SECRET=

# One entry per account manager: console username, name, email, daily capacity.
# The email must match the fa_email Cytonn sends for that manager's clients, or
# those clients are shared out across the roster instead of following their manager.
# ACE_FA_ROSTER=fa_one:FA One:fa1@example.com:19,fa_two:FA Two:fa2@example.com:19

# FA_ASSIGNMENT_SOURCE=

# --- Campaign orchestration (editable in Settings) ---
# CAMPAIGN_COOLDOWN_DAYS=7

# Where the agent's voice, safety, output, and personalization rules come
# from. hardcoded keeps today's behavior regardless of what is seeded into
# the prompt config tables; db reads the active row for each component.
# PROMPT_CONFIG_SOURCE=hardcoded

# Whether weekly report facts are used in emails and SMS (editable in Settings).
# RAG_ENABLED=true

# REQUIRE_DELIVERABLE_CONTACT=true

# --- Proactive agent watch list (editable in Settings) ---
# How recent a first deposit has to be for a client to count as newly signed up.
# AGENT_NEW_CLIENT_DAYS=30
# How long a client may sit on a call list with nothing logged before the agent
# picks them up.
# AGENT_AWAITING_CALL_DAYS=2
# How many days a client stays off limits after being contacted, before the
# agent may propose reaching them again.
# AGENT_CONTACT_COOLDOWN_DAYS=7

# Where all seven watch list groups read from. legacy runs each group's own
# query over the active book, unchanged. situations reads the
# client_situation_state table instead, and needs that day's signal and
# situation recompute functions (app/agents/signals.py, app/agents/situations.py)
# to have already run for every group; flipping this to situations before
# that has run reads an empty or stale group.
# SIGNAL_SITUATION_SOURCE=legacy

# --- What the agent may spend investigating a group (editable in Settings) ---
# How many of its own queries one investigation of a group may ask.
# AGENT_QUERY_CALL_BUDGET=12
# How long the database will spend on any one of them.
# AGENT_QUERY_TIMEOUT_MS=5000
# How much work one filter may ask for.
# AGENT_QUERY_MAX_CONDITIONS=10
# AGENT_QUERY_MAX_VALUES=25
# AGENT_QUERY_MAX_PERIODS=12
# A group smaller than this is not reported at all: with a narrow enough
# filter, a count of one is a person.
# AGENT_QUERY_MIN_GROUP_SIZE=5

# How many findings one agent run may write down, so a screen cannot be flooded.
# AGENT_INSIGHT_WRITE_CAP=8

# How many turns one group's investigation may take, and how many groups
# the intelligence agent may investigate at the same time.
# AGENT_INVESTIGATION_MAX_TURNS=8
# AGENT_INVESTIGATION_CONCURRENCY=3

# How many turns one chat question may take before it must answer.
# AGENT_CHAT_MAX_TURNS=10

# ACTION_RESULT_WINDOW_DAYS=7,30,90

# The results dashboard. The lookback is how many days back the numbers cover
# when no date range is asked for. The window is which result window the money
# numbers read, counted in days from the day a message was sent. The stay
# balance is how much a client must still hold after a deposit for it to count
# as a loss prevented, in KES.
# METRICS_LOOKBACK_DAYS=90
# METRICS_WINDOW_DAYS=30
# METRICS_STAY_BALANCE_KES=1000

# How long one row of the results summary covers. Write it as hours or days,
# for example 12h, 36h, 1d or 7d. Rows are cut on fixed boundaries counted from
# Monday 1 January 2024 in the database time zone, so 7d gives Monday to Sunday
# weeks and 12h gives midnight to noon and noon to midnight. The job that fills
# the summary can run as often as you like, at least as often as this period.
# ACTION_PERFORMANCE_PERIOD=7d
# How far back the agents look when they read the summary, in the same format.
# ACTION_PERFORMANCE_LOOKBACK=90d
# Which result window the agents read. It must be one of ACTION_RESULT_WINDOW_DAYS.
# ACTION_PERFORMANCE_READ_WINDOW_DAYS=30

# The weekly search for patterns nobody asked for. A group of messages smaller
# than the minimum size is never reported, and neither is a gap smaller than the
# minimum number of percentage points. The minimum z score is how far a gap must
# sit from what chance alone would give, 3 being about one chance in 370. A group
# is made of at most the stated number of features, and a run keeps only the
# strongest few.
# PATTERN_MIN_GROUP_SIZE=30
# PATTERN_MIN_GAP_POINTS=5
# PATTERN_MIN_Z=3
# PATTERN_MAX_FEATURES=3
# PATTERN_MAX_PER_RUN=10

# Changing the label on a client, such as active to dormant. The agent may name
# at most the first number of client funds in one finding. A rule that is set to
# act on its own may change at most the second number in one go. A bigger change
# waits for a person even when the rule says automatic.
# LIFECYCLE_INSIGHT_MAX_CLIENTS=5000
# LIFECYCLE_AUTO_MAX_CLIENTS=100

# Watching a run as it happens, over a request that stays open. Each open
# stream holds a database connection, which is what the open limit caps. The
# keep alive is how often a quiet stream sends something, so nothing in front
# of this API decides the line is dead and closes it.
# AGENT_STREAM_MAX_OPEN=20
# AGENT_STREAM_KEEPALIVE_SECONDS=15
# AGENT_STREAM_POLL_SECONDS=1
# AGENT_STREAM_MAX_SECONDS=3600

# --- Operational admin (SQLAdmin, mounted at /admin) ---
# A blank username or password refuses every login. Set both to enable it.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# Signs the admin login session cookie. Set a real random value outside dev.
# ADMIN_SECRET_KEY=

# --- Reviewer console (mounted at /reviewer) ---
# Signs the reviewer console's login session cookie. Set a real random
# value outside dev; accounts are created with scripts/create_reviewer_user.py.
# CONSOLE_SESSION_SECRET_KEY=
