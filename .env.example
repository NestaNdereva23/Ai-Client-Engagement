# AI Client Engagement (ACE)

# --- Application ---
APP_ENV=development              # development | staging | production
APP_NAME=AI Client Engagement
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1

# --- Database (PostgreSQL with the pgvector extension) ---
DATABASE_URL=postgresql+psycopg://**:***@localhost:5432/ace
DB_TIMEZONE=Africa/Nairobi       # time zone for database timestamps (EAT, UTC+3)
# DB_SAFE_ROLE=***   
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
#
# The test suite never touches the database above: tests/conftest.py

# TEST_DATABASE_URL=postgresql+psycopg://**:**@localhost:5432/ace_test

CY_API_BASE_URL=
CY_API_KEY=
# Full URL for the active-clients feed (Phase 2). Same API key, different path.
CY_ACTIVE_CLIENTS_URL=

# --- Retrieval grounding ---
# How many report passages a draft is grounded on, and the similarity below
# which a passage is dropped even if it ranks in the top k. Both stay tight:
# every passage the model sees is a figure it may quote.
# RAG_RETRIEVAL_K=3
# RAG_MIN_SCORE=0.1

# LLM provider
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=
# LLM_TEMPERATURE=         
# LLM_MAX_TOKENS=1024

# LLM_PROVIDER=ollama
# LLM_MODEL=phi4-mini
# OLLAMA_BASE_URL=
# OLLAMA_TIMEOUT_SECONDS=120

# LLM-as-judge (llmops.judge). Falls back to LLM_PROVIDER/LLM_MODEL when unset.
# JUDGE_LLM_PROVIDER=
# JUDGE_LLM_MODEL=
# JUDGE_LLM_TEMPERATURE=
# JUDGE_LLM_MAX_TOKENS=512

# AI-narrated briefing (briefing.narrative). Off by default -- the
# deterministic briefing (GET /briefing/{id}/{fund}) is sufficient on its
# own; this only adds the optional GET /briefing/{id}/{fund}/narrative route.
# AI_BRIEFING_ENABLED=false
# Falls back to LLM_PROVIDER/LLM_MODEL when unset, same as JUDGE_LLM_* above.
# BRIEFING_LLM_PROVIDER=
# BRIEFING_LLM_MODEL=
# BRIEFING_LLM_TEMPERATURE=
# BRIEFING_LLM_MAX_TOKENS=1024
# How many of a digest's clients the nightly run pre-drafts a narration for,
# best-ranked first, so opening one in the morning is instant. Everyone else
# is narrated on request. 0 leaves every narration on demand.
# BRIEFING_PREWARM_LIMIT=200

# --- LLM observability / tracing (Langfuse) ---
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_POSTGRES_USER=
# LANGFUSE_POSTGRES_PASSWORD=
# LANGFUSE_POSTGRES_DB=
# LANGFUSE_POSTGRES_PORT=5433
# LANGFUSE_DATABASE_URL=
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_NEXTAUTH_URL=
# LANGFUSE_REDIS_AUTH=
# LANGFUSE_MINIO_ROOT_PASSWORD=
# LANGFUSE_INIT_ORG_ID=
# LANGFUSE_INIT_ORG_NAME=
# LANGFUSE_INIT_PROJECT_ID=
# LANGFUSE_INIT_PROJECT_NAME=
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# LANGFUSE_INIT_PROJECT_SECRET_KEY=
# LANGFUSE_INIT_USER_EMAIL=
# LANGFUSE_INIT_USER_NAME=
# LANGFUSE_INIT_USER_PASSWORD=

# --- Outgoing mail (SMTP) ---
# Where mail goes out. Unset SMTP_HOST means nothing is sent: the mailer
# records what it was asked to send and stays quiet, so a half-configured
# environment does not fail in the middle of a scheduled run.
# Local development points at Mailpit from docker compose (no username,
# no password, no TLS) and reads the inbox at http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
# SMTP_TIMEOUT_SECONDS=30
# The From address on everything the system sends. Blank means nothing sends.
# EMAIL_SENDER=
# Where the FA console is reachable. The morning digest email builds its
# links off this. Blank renders the email with no links at all.
# CONSOLE_BASE_URL=http://localhost:5173

# --- Email delivery and inbound event webhooks ---
# The provider alternative for client-facing dormant sends, which may want
# delivery events (opens, bounces) that plain SMTP does not report.
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=
# EMAIL_WEBHOOK_SIGNING_KEY=

# --- Integration plane (stopgap ahead of M8A.7's real integration auth) ---
# Shared secret the parent system sends as X-Integration-Key. Unset means
# every /integration/* request is refused.
# INTEGRATION_API_KEY=

# --- Reviewer identity (stopgap ahead of real session/role auth) ---
# Verifies the Authorization: Bearer <jwt> Ticketing attaches to every
# call, gating GET /clients/{id}/name and the review/template decide
# endpoints (GET /briefing/{client_id}/{unit_fund_id} is unaffected -- see
# api/routers/briefing.py for why). Must match Ticketing's own
# AI_OUTREACH_JWT_SECRET exactly, or every token fails to verify. Unset
# means every endpoint behind it refuses every request. Do not set this in
# any environment holding real client data until real session/role auth
# exists.
# AI_OUTREACH_JWT_SECRET=

# --- Account managers (seeded by hand: the active-clients feed has no
# relationship-manager field to read one from) ---
# Format: "fa_id:name:email:daily_capacity", comma separated. daily_capacity
# is how many clients that person can call in one morning. Unset means no
# roster: nobody is assigned and the morning digest keeps grouping by fund.
# Use placeholder names here, never real staff addresses.
# ACE_FA_ROSTER=fa_one:FA One:fa1@example.com:19,fa_two:FA Two:fa2@example.com:19

# Which assignment source to read. Empty (the default) picks the database
# source when ACE_FA_ROSTER is set and the no-assignment stub when it is not.
# FA_ASSIGNMENT_SOURCE=

# --- Campaign orchestration ---
# CAMPAIGN_COOLDOWN_DAYS=7

# On (default, safe everywhere) refuses to generate or send for a client
# with no contact_email/contact_whatsapp on file. Only turn this off in a
# local .env, before /integration/contacts has real data flowing into it.
# REQUIRE_DELIVERABLE_CONTACT=true

# --- Operational admin (SQLAdmin, mounted at /admin) ---
# A blank username or password refuses every login. Set both to enable it.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# Signs the admin login session cookie. Set a real random value outside dev.
# ADMIN_SECRET_KEY=

# --- Reviewer console (mounted at /reviewer) ---
# Signs the reviewer console's login session cookie. Set a real random
# value outside dev; accounts are created with scripts/create_reviewer_user.py.
# CONSOLE_SESSION_SECRET_KEY=
