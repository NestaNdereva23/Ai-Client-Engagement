# AI Client Engagement (ACE) - environment template

# --- Application ---
APP_ENV=development              # development | staging | production
APP_NAME=AI Client Engagement
LOG_LEVEL=INFO

# --- Database (PostgreSQL with the pgvector extension) ---
# DATABASE_URL is what the app connects with. The POSTGRES_* values initialise
# the docker-compose container and must stay consistent with it.
DATABASE_URL=postgresql+psycopg://ace:ace@localhost:5432/ace
DB_TIMEZONE=Africa/Nairobi       # time zone for database timestamps (EAT, UTC+3)
# DB_SAFE_ROLE=***        # role the model-facing path switches into; no grant on pii_vault
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# --- Cytonn client-data API (the source of client records) ---
CY_API_BASE_URL=
CY_API_KEY=                      # sent as the X-API-Key header; do not commit the real key

# --- LLM provider (drafts the outreach emails) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5
# LLM_TEMPERATURE=              # omitted by default; newer Claude models reject a non-default value
# LLM_MAX_TOKENS=1024

# --- LLM observability / tracing (Langfuse) ---
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# --- Email delivery and inbound event webhooks ---
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=
# EMAIL_SENDER=
# EMAIL_WEBHOOK_SIGNING_KEY=
