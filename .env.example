# AI Client Engagement (ACE) - environment template
# Copy to .env and fill in local values. NEVER commit .env with real secrets.
# Commented-out sections are for features that are not wired up yet;
# uncomment and set them when that feature is enabled.

# --- Application ---
APP_ENV=development              # development | staging | production
APP_NAME=AI Client Engagement
LOG_LEVEL=INFO

# --- Database (PostgreSQL with the pgvector extension) ---
DATABASE_URL=postgresql+psycopg://ace:ace@localhost:5432/ace

# --- Cytonn client-data API (the source of client records) ---
CYTONN_API_BASE_URL=
CYTONN_API_KEY=                  # sent as the X-API-Key header; do not commit the real key

# --- LLM provider (drafts the outreach emails) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- LLM observability / tracing (Langfuse) ---
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# --- Email delivery and inbound event webhooks ---
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=
# EMAIL_SENDER=
# EMAIL_WEBHOOK_SIGNING_KEY=
