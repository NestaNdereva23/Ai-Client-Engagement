# AI Client Engagement (ACE)

# --- Application ---
APP_ENV=development              # development | staging | production
APP_NAME=AI Client Engagement
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1

# --- Database (PostgreSQL with the pgvector extension) ---
DATABASE_URL=postgresql+psycopg://**:***@localhost:5432/ace
DB_TIMEZONE=Africa/Nairobi       # time zone for database timestamps (EAT, UTC+3)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# DB_ASYNC_POOL_SIZE=10       # async pool, defaults to DB_POOL_SIZE
# DB_ASYNC_MAX_OVERFLOW=10    # async overflow, defaults to DB_MAX_OVERFLOW
WORKER_THREADS=40
SLOW_REQUEST_MS=1000
# DB_SAFE_ROLE=***   
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# TEST_DATABASE_URL=postgresql+psycopg://**:**@localhost:5432/ace_test

CY_API_BASE_URL=
CY_API_KEY=
# Full URL for the active-clients feed (Phase 2). Same API key, different path.
CY_ACTIVE_CLIENTS_URL=

# --- Retrieval grounding ---
# RAG_RETRIEVAL_K=3
# RAG_MIN_SCORE=0.1

# LLM provider
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=
# LLM_TEMPERATURE=         
# LLM_MAX_TOKENS=1024

# LLM_PROVIDER=ollama
# LLM_MODEL=phi4-mini
# OLLAMA_BASE_URL=
# OLLAMA_TIMEOUT_SECONDS=120

# LLM_PROVIDER=llamacpp
# LLM_MODEL=local-model
# LLAMACPP_BASE_URL=http://localhost:8080
# LLAMACPP_TIMEOUT_SECONDS=300

# LLM-as-judge (llmops.judge). Falls back to LLM_PROVIDER/LLM_MODEL when unset.
# JUDGE_LLM_PROVIDER=
# JUDGE_LLM_MODEL=
# JUDGE_LLM_TEMPERATURE=
# JUDGE_LLM_MAX_TOKENS=512

# AI-narrated briefing
# AI_BRIEFING_ENABLED=false
# Falls back to LLM_PROVIDER/LLM_MODEL when unset, same as JUDGE_LLM_* above.
# BRIEFING_LLM_PROVIDER=
# BRIEFING_LLM_MODEL=
# BRIEFING_LLM_TEMPERATURE=
# BRIEFING_LLM_MAX_TOKENS=1024
# BRIEFING_PREWARM_LIMIT=200


# LLM_PROVIDER/LLM_MODEL when unset.
# AGENT_LLM_PROVIDER=
# AGENT_LLM_MODEL=
# AGENT_LLM_TEMPERATURE=
# AGENT_LLM_MAX_TOKENS=2048
# AGENT_RUN_AFTER_RISK_DETECTION=false

# --- LLM observability / tracing (Langfuse) ---
# LANGFUSE_BASE_URL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_POSTGRES_USER=
# LANGFUSE_POSTGRES_PASSWORD=
# LANGFUSE_POSTGRES_DB=
# LANGFUSE_POSTGRES_PORT=5433
# LANGFUSE_DATABASE_URL=
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_NEXTAUTH_URL=
# LANGFUSE_REDIS_AUTH=
# LANGFUSE_MINIO_ROOT_PASSWORD=
# LANGFUSE_INIT_ORG_ID=
# LANGFUSE_INIT_ORG_NAME=
# LANGFUSE_INIT_PROJECT_ID=
# LANGFUSE_INIT_PROJECT_NAME=
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# LANGFUSE_INIT_PROJECT_SECRET_KEY=
# LANGFUSE_INIT_USER_EMAIL=
# LANGFUSE_INIT_USER_NAME=
# LANGFUSE_INIT_USER_PASSWORD=

# --- Outgoing mail (SMTP) ---
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
# SMTP_TIMEOUT_SECONDS=30
# The From address on everything the system sends. Blank means nothing sends.
# EMAIL_SENDER=
# CONSOLE_BASE_URL=http://localhost:5173

# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=
# EMAIL_WEBHOOK_SIGNING_KEY=


# AI_OUTREACH_JWT_SECRET=

# ACE_FA_ROSTER=fa_one:FA One:fa1@example.com:19,fa_two:FA Two:fa2@example.com:19

# FA_ASSIGNMENT_SOURCE=

# --- Campaign orchestration ---
# CAMPAIGN_COOLDOWN_DAYS=7

# Where the agent's voice, safety, output, and personalization rules come
# from. hardcoded keeps today's behavior regardless of what is seeded into
# the prompt config tables; db reads the active row for each component.
# PROMPT_CONFIG_SOURCE=hardcoded

# Hard off switch for retrieval-augmented facts in generation, regardless of
# the rag_settings row in the database. Leave true; turn off only to rule
# out RAG while debugging.
# RAG_ENABLED=true

# REQUIRE_DELIVERABLE_CONTACT=true

# --- Proactive agent watch list ---
# How recent a first deposit has to be for a client to count as newly signed up.
# AGENT_NEW_CLIENT_DAYS=30
# How long a client may sit on a call list with nothing logged before the agent
# picks them up.
# AGENT_AWAITING_CALL_DAYS=2
# How many days a client stays off limits after being contacted, before the
# agent may propose reaching them again.
# AGENT_CONTACT_COOLDOWN_DAYS=7

# --- What the agent may spend investigating a group ---
# How many of its own queries one investigation of a group may ask.
# AGENT_QUERY_CALL_BUDGET=12
# How long the database will spend on any one of them.
# AGENT_QUERY_TIMEOUT_MS=5000
# How much work one filter may ask for.
# AGENT_QUERY_MAX_CONDITIONS=10
# AGENT_QUERY_MAX_VALUES=25
# AGENT_QUERY_MAX_PERIODS=12
# A group smaller than this is not reported at all: with a narrow enough
# filter, a count of one is a person.
# AGENT_QUERY_MIN_GROUP_SIZE=5

# How many findings one agent run may write down, so a screen cannot be flooded.
# AGENT_INSIGHT_WRITE_CAP=8

# How many turns one group's investigation may take, and how many groups
# the intelligence agent may investigate at the same time.
# AGENT_INVESTIGATION_MAX_TURNS=8
# AGENT_INVESTIGATION_CONCURRENCY=3

# Watching a run as it happens, over a request that stays open. Each open
# stream holds a database connection, which is what the open limit caps. The
# keep alive is how often a quiet stream sends something, so nothing in front
# of this API decides the line is dead and closes it.
# AGENT_STREAM_MAX_OPEN=20
# AGENT_STREAM_KEEPALIVE_SECONDS=15
# AGENT_STREAM_POLL_SECONDS=1
# AGENT_STREAM_MAX_SECONDS=3600

# --- Operational admin (SQLAdmin, mounted at /admin) ---
# A blank username or password refuses every login. Set both to enable it.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# Signs the admin login session cookie. Set a real random value outside dev.
# ADMIN_SECRET_KEY=

# --- Reviewer console (mounted at /reviewer) ---
# Signs the reviewer console's login session cookie. Set a real random
# value outside dev; accounts are created with scripts/create_reviewer_user.py.
# CONSOLE_SESSION_SECRET_KEY=
